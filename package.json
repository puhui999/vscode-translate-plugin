{
  "name": "vscode-translate-plugin",
  "displayName": "注释译读 · AI Comment Translator",
  "description": "SQLite 缓存与批量 AI 注释翻译：无边框多行源码阅读视图、原生行尾预览，自定义 OpenAI 兼容服务。",
  "version": "0.2.3",
  "publisher": "local-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "translation",
    "ai",
    "注释翻译"
  ],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "commentTranslator.configure",
        "title": "注释译读：配置模型服务"
      },
      {
        "command": "commentTranslator.toggle",
        "title": "注释译读：开启 / 关闭当前文件翻译"
      },
      {
        "command": "commentTranslator.toggleAutomatic",
        "title": "注释译读：开启 / 关闭自动翻译"
      },
      {
        "command": "commentTranslator.refresh",
        "title": "注释译读：重试当前文件（复用缓存）"
      },
      {
        "command": "commentTranslator.translateRemaining",
        "title": "注释译读：继续翻译下一批 500 条注释"
      },
      {
        "command": "commentTranslator.clearCache",
        "title": "注释译读：清除翻译缓存"
      },
      {
        "command": "commentTranslator.removeApiKey",
        "title": "注释译读：删除当前服务的 API Key"
      },
      {
        "command": "commentTranslator.showStatus",
        "title": "注释译读：查看当前文件翻译状态"
      },
      {
        "command": "commentTranslator.demo",
        "title": "注释译读：打开离线效果示例（无需 API）"
      },
      {
        "command": "commentTranslator.openSettings",
        "title": "注释译读：打开翻译设置"
      },
      {
        "command": "commentTranslator.openReader",
        "title": "注释译读：打开无边框多行阅读视图"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "commentTranslator.toggle",
          "group": "navigation@20",
          "when": "editorTextFocus && !isInDiffEditor"
        },
        {
          "command": "commentTranslator.openReader",
          "group": "navigation@21",
          "when": "editorTextFocus && !isInDiffEditor"
        }
      ]
    },
    "configuration": {
      "title": "注释译读",
      "properties": {
        "commentTranslator.automatic": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "配置好服务地址与模型后，自动翻译打开的受支持源码文件（如 Java）；仅未缓存的注释会发送到你配置的服务。开关在重启后保留，关闭后可手动翻译单个文件。"
        },
        "commentTranslator.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "任意 OpenAI Chat Completions 兼容服务的 HTTP/HTTPS 地址，例如 `https://example.com/v1`、`http://192.168.1.10:8000/v1`，也支持完整 `/chat/completions` 地址。注释直接发送到你配置的服务，无厂商限制。"
        },
        "commentTranslator.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "服务支持的任意模型 ID，按填写值发送，无模型白名单。"
        },
        "commentTranslator.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "模型服务的 API Key；非空时优先使用此值，留空则使用配置命令保存的加密凭据。**此设置以明文保存在用户 settings.json 中，请勿提交到公开配置。**也可运行“注释译读：配置模型服务”将 Key 保存到 VS Code SecretStorage。无需认证的服务可留空。"
        },
        "commentTranslator.targetLanguage": {
          "type": "string",
          "default": "简体中文",
          "description": "译文目标语言。",
          "scope": "resource"
        },
        "commentTranslator.prompt": {
          "type": "string",
          "default": "",
          "description": "附加翻译要求，例如术语翻译习惯；不会改变 ID 和 JSON 输出协议。",
          "editPresentation": "multilineText",
          "scope": "resource"
        },
        "commentTranslator.responseFormat": {
          "type": "string",
          "enum": [
            "text",
            "json_object",
            "json_schema"
          ],
          "default": "text",
          "scope": "machine",
          "enumDescriptions": [
            "通用兼容模式：通过提示词要求 JSON，本地校验结果。",
            "JSON 模式：服务必须支持 response_format。",
            "严格结构化模式：服务及模型必须支持 JSON Schema。"
          ]
        },
        "commentTranslator.maxBatchChars": {
          "type": "number",
          "default": 16000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "每个请求的注释字符预算。小文件合并成一个请求，大文件自动拆批；这不是模型 token 数。",
          "scope": "resource"
        },
        "commentTranslator.maxOutputTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 512,
          "maximum": 65536,
          "description": "每批输出 token 上限，须符合服务和模型限制；tokenLimitParameter 为 omit 时不发送此上限。",
          "scope": "resource"
        },
        "commentTranslator.tokenLimitParameter": {
          "type": "string",
          "enum": [
            "max_tokens",
            "max_completion_tokens",
            "omit"
          ],
          "default": "max_tokens",
          "scope": "machine",
          "enumDescriptions": [
            "使用 max_tokens 发送输出上限，适用于常见兼容服务。",
            "使用 max_completion_tokens 发送输出上限，适用于要求此参数的模型。",
            "不发送输出上限参数，由服务及模型使用默认值。"
          ]
        },
        "commentTranslator.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "description": "单次请求超时秒数。",
          "scope": "resource"
        },
        "commentTranslator.debounceMs": {
          "type": "number",
          "default": 600,
          "minimum": 100,
          "maximum": 5000,
          "description": "修改注释后等待多少毫秒再更新翻译。",
          "scope": "resource"
        },
        "commentTranslator.visibleBufferLines": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 100,
          "description": "可见区域上下额外显示译文的行数。翻译按整个文件批量进行，此设置仅控制显示范围。",
          "scope": "resource"
        },
        "commentTranslator.trailingPreviewLength": {
          "type": "number",
          "default": 80,
          "minimum": 10,
          "maximum": 300,
          "description": "行尾译文正文预览字符预算，注释符号和结束标记另行保留；悬浮可查看完整格式。",
          "scope": "resource"
        },
        "commentTranslator.displayMode": {
          "type": "string",
          "enum": [
            "reader",
            "inline"
          ],
          "default": "reader",
          "scope": "resource",
          "enumDescriptions": [
            "开启当前文件翻译时打开独立只读阅读视图，显示无边框多行译文；点击行号返回源码。",
            "留在原生编辑器，在注释行末显示单行译文预览，悬浮查看完整多行文本。"
          ],
          "description": "译文显示方式。原生编辑器中不会创建评论框，多行排版在独立阅读视图中提供。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run compile && node scripts/test-electron.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --out artifacts/"
  },
  "dependencies": {
    "@shikijs/langs": "4.4.3",
    "sql.js": "^1.14.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "1.85.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puhui999/vscode-translate-plugin.git"
  },
  "homepage": "https://github.com/puhui999/vscode-translate-plugin#readme",
  "bugs": {
    "url": "https://github.com/puhui999/vscode-translate-plugin/issues"
  }
}
