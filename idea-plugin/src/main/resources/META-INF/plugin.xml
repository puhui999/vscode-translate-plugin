<idea-plugin>
  <id>com.puhui.comment-translator</id>
  <name>注释译读 · AI Comment Translator</name>
  <vendor url="https://github.com/puhui999/vscode-translate-plugin">puhui999</vendor>
  <description><![CDATA[
    在原注释位置显示 AI 译文，独立注释支持无边框多行排版，悬停查看原文，点击后编辑。
    支持自定义 OpenAI 兼容服务、逐条并发请求、目标语言识别、本地 SQLite 缓存，以及可选的上下对照显示。
    译文不会写入源码。包含无需 API 的离线体验示例。
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="com.puhui.commenttranslator.TranslationStartup"/>
    <applicationConfigurable parentId="tools" id="com.puhui.comment-translator.settings" displayName="注释译读" instance="com.puhui.commenttranslator.settings.TranslationConfigurable"/>
    <statusBarWidgetFactory id="PuhuiCommentTranslatorStatus" implementation="com.puhui.commenttranslator.TranslationStatusFactory"/>
    <notificationGroup id="Comment Translator" displayType="BALLOON"/>
    <editorActionHandler action="EditorDelete" implementationClass="com.puhui.commenttranslator.editor.TranslationDeleteHandler" order="first"/>
    <editorActionHandler action="EditorBackSpace" implementationClass="com.puhui.commenttranslator.editor.TranslationBackspaceHandler" order="first"/>
    <editorActionHandler action="EditorDeleteToWordEnd" implementationClass="com.puhui.commenttranslator.editor.TranslationDeleteHandler" order="first"/>
    <editorActionHandler action="EditorDeleteToWordStart" implementationClass="com.puhui.commenttranslator.editor.TranslationBackspaceHandler" order="first"/>
    <editorActionHandler action="EditorCut" implementationClass="com.puhui.commenttranslator.editor.TranslationCutHandler" order="first"/>
    <editorActionHandler action="EditorDeleteLine" implementationClass="com.puhui.commenttranslator.editor.TranslationDeleteLineHandler" order="first"/>
  </extensions>
  <actions>
    <group id="CommentTranslator.Menu" text="注释译读" popup="true">
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="CommentTranslator.TranslateFile" class="com.puhui.commenttranslator.actions.TranslateFileAction" text="检查 / 继续翻译当前文件"/>
      <action id="CommentTranslator.TranslateComment" class="com.puhui.commenttranslator.actions.TranslateCommentAction" text="翻译当前注释"/>
      <action id="CommentTranslator.ToggleVisible" class="com.puhui.commenttranslator.actions.ToggleVisibleAction" text="显示 / 隐藏译文"/>
      <action id="CommentTranslator.ToggleAutomatic" class="com.puhui.commenttranslator.actions.ToggleAutomaticAction" text="自动翻译"/>
      <action id="CommentTranslator.Reader" class="com.puhui.commenttranslator.actions.ReaderAction" text="打开只读译文"/>
      <action id="CommentTranslator.CopyTranslation" class="com.puhui.commenttranslator.actions.CopyTranslationAction" text="复制当前译文"/>
      <action id="CommentTranslator.ExpandTranslation" class="com.puhui.commenttranslator.actions.ExpandTranslationAction" text="切换当前注释原文 / 展开译文"/>
      <separator/>
      <action id="CommentTranslator.Settings" class="com.puhui.commenttranslator.actions.SettingsAction" text="配置翻译服务…"/>
      <action id="CommentTranslator.ClearCache" class="com.puhui.commenttranslator.actions.ClearCacheAction" text="清除本地翻译缓存"/>
      <action id="CommentTranslator.Demo" class="com.puhui.commenttranslator.actions.DemoAction" text="打开离线体验示例"/>
    </group>
  </actions>
</idea-plugin>
